/*
 * Cecli TUI Styles
 *
 * Uses Textual theme variables for consistent theming.
 * Theme defined in app.py (AIDER_THEME).
 */

* {
    background: $background;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $secondary;
    scrollbar-color-hover: $accent;  
    scrollbar-color-active: $accent;     
}

Screen {
    background: $background;
    layout: vertical;
    padding: 0;
    margin: 0;
    border: none;    
}

/* Input row: input container plus the floating status panels */
#input-row {
    height: auto;
    width: 100%;
    padding: 0;
    margin: 0;
    align-vertical: top;
}

#input-column {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 0;
}

#extensions-column {
    width: 43;
    height: auto;
    margin: 0;
    padding: 0;
}

/* Output area */
#output,  .subagent-output {
    height: 1fr;
    width: 100%;
    background: $surface;
    padding: 0 0 0 1;
    margin: 0;
    scrollbar-size: 1 1;
}

/* Input area - floating card style */
#input-container {
    height: auto;
    width: 1fr;
    max-height: 33vh;
    min-height: 0;
    padding: 0 0 0 1;
    margin: 0 1 0 1;
    border: round $accent 50%;
    border-title-align: right;
    border-subtitle-align: right;
    background: $surface;
}

#input {
    max-height: 1fr;
    height: auto;
    min-height: 3;
    background: $surface;
    border: none;
    padding: 0 0 0 0;
    margin: 0 2 0 0;
    scrollbar-size: 1 1;
}

#input:focus {
    background: $surface;
}

/* Generic Input and TextArea styling */
Input, TextArea {
    background: $surface;
    border: none;
}

Input:focus, TextArea:focus {
    border: none;
    background: $surface;
}

Input > .input--placeholder, TextArea > .text-area--placeholder  {
    color: $secondary;
    background: $surface;
}

TextArea > .text-area--selection {
    color: $success;
    background: $foreground;
}

/* File List below input */
#file-list {
    padding: 0 0 0 0;
    margin: 0;
    background: $surface;
    color: $secondary;
    height: auto;
    min-height: 0;
    dock: bottom
}

#file-list.empty {
    height: 0;
    margin: 0;
    padding: 0;    
    display: none;
}

/* Key hints sit inside the same column as their box */
#key-hints {
    color: $secondary;
    height: 1;
    width: 1fr;
    padding: 0 1 0 1;
    margin: 0 1 1 1;
}

#extensions-hint {
    width: 1fr;
    height: 1;
    padding: 0 1 0 1;
    margin: 0 1 1 0;
    color: $secondary;
    text-align: right;
}

#key-hints > .key-hints-left {
    color: $secondary;
    width: auto;
}

#key-hints > .key-hints-right {
    text-align: right;
    color: $secondary;
    width: 1fr;
}

/* Footer - same background as everything else */
#footer {
    height: 1;
    width: 100%;
    background: $surface;
    color: $accent;
    padding: 0 1;
}
