{
  "name": "cecli-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri v2 shell for the cecli desktop bridge and UI",
  "type": "module",
  "scripts": {
    "tauri": "node scripts/run_tauri.mjs",
    "dev": "node scripts/run_tauri.mjs dev",
    "build": "node scripts/run_tauri.mjs build",
    "ui:dev": "vite --config ui/vite.config.js",
    "ui:build": "vite build --config ui/vite.config.js",
    "ui:watch": "vite build --config ui/vite.config.js --watch",
    "ui:check": "node scripts/check_ui.mjs",
    "test:ui": "node --test ui/tests/*.test.js",
    "gen:icons": "python3 scripts/gen_icons.py",
    "icon": "tauri icon src-tauri/icons/icon.png",
    "runtime:install": "python3 scripts/install_runtime.py"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "katex": "0.19.1",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
