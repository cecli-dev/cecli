{
  "name": "cecli-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri v2 shell for the cecli desktop bridge and UI",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "ui:dev": "vite --config ui/vite.config.js",
    "ui:build": "vite build --config ui/vite.config.js",
    "ui:watch": "vite build --config ui/vite.config.js --watch",
    "ui:check": "node scripts/check_ui.mjs",
    "test:ui": "node --test ui/tests/*.test.js",
    "gen:icons": "python3 scripts/gen_icons.py",
    "icon": "tauri icon src-tauri/icons/icon.png"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
